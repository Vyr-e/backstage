{
  "name": "@vyr-e/backstage",
  "version": "1.2.1",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js",
      "require": "./dist/queue.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "import": "./dist/scheduler.js",
      "require": "./dist/scheduler.js"
    },
    "./reclaimer": {
      "types": "./dist/reclaimer.d.ts",
      "import": "./dist/reclaimer.js",
      "require": "./dist/reclaimer.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.js"
    },
    "./rabbitmq": {
      "types": "./dist/provider/rabbitmq/index.d.ts",
      "import": "./dist/provider/rabbitmq/index.js",
      "require": "./dist/provider/rabbitmq/index.js"
    },
    "./kafka": {
      "types": "./dist/provider/kafka/index.d.ts",
      "import": "./dist/provider/kafka/index.js",
      "require": "./dist/provider/kafka/index.js"
    }
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build ./src/index.ts ./src/core.ts ./src/worker.ts ./src/queue.ts ./src/scheduler.ts ./src/reclaimer.ts ./src/types.ts ./src/testing/index.ts ./src/provider/rabbitmq/index.ts ./src/provider/kafka/index.ts --outdir ./dist --target bun --root ./src --external kafkajs --external amqplib && tsc --project tsconfig.build.json --emitDeclarationOnly --outDir ./dist --rootDir ./src",
    "test": "bun test",
    "run-workers": "bun run src/cli.ts run-workers",
    "run-scheduler": "bun run src/cli.ts run-scheduler",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bun": "^1.3.8",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "amqplib": "^0.10.0",
    "kafkajs": "^2.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "winston": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "amqplib": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    }
  }
}
